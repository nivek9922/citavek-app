# .env.example — plantilla de variables de entorno.
# Copia este archivo como .env y rellena los valores reales.
# Este archivo SÍ se sube a GitHub. El .env NUNCA se sube.

# ── Base de datos ──────────────────────────────────────────────────────────────
# Proveedor recomendado: Neon (https://neon.tech) — PostgreSQL serverless.
#
# DATABASE_URL: cadena de conexión principal. En producción usa la URL del
#   pooler (PgBouncer) para mayor eficiencia. En local apunta directo a Docker.
#
# DIRECT_URL: conexión directa sin pooler. La requiere `prisma migrate` porque
#   PgBouncer no soporta DDL. En local es la misma que DATABASE_URL.
#
# Cómo obtenerlas en Neon → tu proyecto → Connection string:
#   DATABASE_URL → elige "Pooler"  (hostname contiene "-pooler")
#   DIRECT_URL   → elige "Direct"  (hostname sin "-pooler")

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Local con Docker/PostgreSQL nativo (misma URL para ambas):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/citavek?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/citavek?schema=public"

# ── Autenticación (Better Auth) ────────────────────────────────────────────────
# Secreto para firmar sesiones. Mínimo 32 caracteres, aleatorio.
# Genera uno con: openssl rand -base64 32
# Cambia este valor en producción. Nunca reutilices el de local.

BETTER_AUTH_SECRET="genera-con-openssl-rand-base64-32"

# ── App ────────────────────────────────────────────────────────────────────────
# URL pública de la app. En Vercel se configura automáticamente.
# En local siempre es http://localhost:3000

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Super Admin ────────────────────────────────────────────────────────────────
# Credenciales del primer usuario administrador.
# Solo se usan al correr: npm run db:seed
# Después del seed en producción estas variables no afectan el runtime.

SUPER_ADMIN_EMAIL="admin@tudominio.com"
SUPER_ADMIN_PASSWORD="minimo-12-caracteres-con-Mayusculas-y-Num3ros"

# ── Cloudinary (imágenes) ──────────────────────────────────────────────────────
# Almacenamiento de imágenes de servicios y logos.
# Registro gratuito en https://cloudinary.com → Dashboard → API Keys
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME

CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
