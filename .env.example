# .env.example — plantilla de variables de entorno.
# Copia este archivo como .env y completa los valores reales.
# Este archivo SÍ se sube a GitHub. El .env NUNCA se sube.

# ── Base de datos ──────────────────────────────────────────────────────────────
# Proveedor recomendado: Neon (https://neon.tech) — PostgreSQL serverless.
#
# DATABASE_URL: URL con pooler (PgBouncer). La usa el app en runtime para
#   todas las consultas. Tiene un límite de conexiones concurrentes menor.
#
# DIRECT_URL: URL de conexión directa (sin pooler). Solo la usan herramientas
#   CLI como `prisma migrate`. NO la usa el app en runtime.
#
# Cómo obtenerlas en Neon:
#   1. Entra a console.neon.tech → tu proyecto
#   2. Clic en "Connection string"
#   3. Selecciona "Pooler"  → copia → pega en DATABASE_URL
#   4. Selecciona "Direct"  → copia → pega en DIRECT_URL
#   La diferencia está en el hostname: el pooler tiene "-pooler" en el nombre.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Para desarrollo local con PostgreSQL en Docker o instalación nativa:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/citavek?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/citavek?schema=public"

# ── Autenticación (Better Auth) ────────────────────────────────────────────────
# Secreto para firmar sesiones y tokens. Mínimo 32 caracteres.
# Genera uno seguro con: openssl rand -base64 32
# IMPORTANTE: cambia este valor en producción. Nunca uses el mismo en local y prod.

BETTER_AUTH_SECRET="genera-con-openssl-rand-base64-32"

# ── App ────────────────────────────────────────────────────────────────────────
# URL base donde corre la app. En Vercel se configura automáticamente.
# En local siempre es http://localhost:3000

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Super Admin ────────────────────────────────────────────────────────────────
# Email y contraseña del usuario administrador global.
# Se usan en prisma/seed.ts para crear el primer usuario.
# Después del primer seed en producción, estas variables no afectan el runtime.

SUPER_ADMIN_EMAIL="admin@tudominio.com"
SUPER_ADMIN_PASSWORD="minimo-12-caracteres-con-mayusculas-y-numeros"

# ── Cloudinary (imágenes) ──────────────────────────────────────────────────────
# Almacenamiento de imágenes de servicios y logos de barberías.
# Registro gratuito en: https://cloudinary.com
# Credenciales en: Dashboard → API Keys
# Formato obligatorio: cloudinary://API_KEY:API_SECRET@CLOUD_NAME

CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
