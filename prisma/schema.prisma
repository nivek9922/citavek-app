// BookingFlow — SaaS multi-tenant para barberías.
// Migración 1 (dominio): Organization raíz + Branding, Service, Barber, WorkingHour,
// Customer, Appointment. Las tablas de better-auth (user/session/account/verification/
// member/invitation) y la exclusion constraint anti-solape llegan en migraciones 2 y 3.
// Ver docs/02-modelo-de-datos-y-prisma.md.
//
// Convención: TODAS las marcas de tiempo son `timestamptz` (@db.Timestamptz(6)).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum OrganizationStatus {
  active
  suspended
}

enum ServiceCategory {
  corte
  barba
  combo
  tratamiento
  infantil
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentSource {
  online
  manual
}

// Tipo de recompensa del programa de lealtad (configurable por tenant).
enum RewardType {
  FREE_NEXT_VISIT // 100% del total de la próxima cita
  DISCOUNT_PCT    // % configurable
  DISCOUNT_AMOUNT // monto fijo en COP
  FREE_SERVICE    // un servicio específico gratis
}

// Tipo de comisión del barbero (configurable por el owner, 1:1 con Barber).
enum CommissionType {
  PERCENTAGE        // % del precio total de cada cita completada
  FIXED_PER_SERVICE // monto fijo en COP por cada servicio individual completado
}

// Plan de suscripción. `basic` es el plan actual; `pro` (WhatsApp automatizado) llega después.
enum PlanType {
  basic
  pro
}

// Ciclo de vida de la suscripción. Independiente de OrganizationStatus:
// OrganizationStatus es el kill-switch manual del admin; SubscriptionStatus es el acceso por pago.
enum SubscriptionStatus {
  trial      // Período de prueba manual
  active     // Pago confirmado
  grace      // Vencido, en período de gracia (5 días)
  suspended  // Sin acceso a crear citas nuevas
  cancelled  // Cancelado definitivamente
}

// ──────────────────── Tenant raíz (Barbería) ────────────────────
// Columnas base compatibles con el plugin `organization` de better-auth
// (id, name, slug, logo, metadata, createdAt) + additionalFields de dominio.

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // additionalFields de dominio
  city     String?
  address  String?
  phone    String?
  timezone String             @default("America/Bogota")
  currency String             @default("COP")
  status   OrganizationStatus @default(active)

  branding           Branding?
  branches           Branch[]
  services           Service[]
  barbers            Barber[]
  customers          Customer[]
  appointments       Appointment[]
  scheduleExceptions ScheduleException[]

  members            Member[]
  invitations        Invitation[]
  reviews            Review[]
  adminNote          AdminNote?
  subscription       Subscription?
  barberInvitations  BarberInvitation[]

  loyaltyProgram     LoyaltyProgram?
  loyaltyCards       LoyaltyCard[]
  loyaltyRedemptions LoyaltyRedemption[]

  barberCommissions     BarberCommission[]
  commissionSettlements CommissionSettlement[]

  @@index([status])
  @@map("organization")
}

// ──────────────────── Suscripción (1:1 con Organization) ────────────────────
// Patrón AdminNote: organizationId @unique → una org tiene exactamente una suscripción.
// Fase 1: gestión manual por Super Admin. Fase 2: Mercado Pago llena mp*/pago vía webhook.

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan   PlanType           @default(basic)
  status SubscriptionStatus @default(trial)

  // Fechas del ciclo
  trialEndsAt        DateTime? @db.Timestamptz(6) // Para barberías en prueba
  currentPeriodStart DateTime? @db.Timestamptz(6) // Inicio del período pagado
  currentPeriodEnd   DateTime? @db.Timestamptz(6) // Vencimiento del período pagado
  graceStartedAt     DateTime? @db.Timestamptz(6) // Inicio del período de gracia (lo fija el cron)

  // Pago (manual por ahora — Mercado Pago en Fase 2)
  lastPaymentAt     DateTime? @db.Timestamptz(6)
  lastPaymentAmount Int?                          // En COP (pesos, sin centavos)
  paymentMethod     String?                       // 'manual' | 'card' | 'pse' | 'nequi' — extensible

  // Cancelación
  cancelledAt  DateTime? @db.Timestamptz(6)
  cancelReason String?

  // Mercado Pago (vacío en Fase 1; el webhook de Fase 2 lo llena)
  mpSubscriptionId String?
  mpCustomerId     String?

  createdAt DateTime @default(now())  @db.Timestamptz(6)
  updatedAt DateTime @updatedAt       @db.Timestamptz(6)

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
  @@index([status, graceStartedAt])
  @@map("subscription")
}

// ──────────────────── Notas internas (solo Super Admin) ────────────────────
// Aislado de Organization para que ninguna query de tenant lo exponga por accidente.

model AdminNote {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  content   String
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("admin_note")
}

// ──────────────────── Sucursales ────────────────────

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  barbers      Barber[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("branch")
}

// ──────────────────── Marca blanca (1:1) ────────────────────

model Branding {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  primaryColor String  @default("#E0A300") // hex; se deriva a OKLCH en runtime
  logoUrl      String?
  tagline      String?
  coverUrl     String?

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("branding")
}

// ──────────────────── Catálogo ────────────────────

model Service {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  durationMin Int // minutos
  priceCop    Int // pesos enteros COP (ej. 25000)
  category    ServiceCategory
  imageUrl    String?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  appointmentServices AppointmentService[]
  loyaltyPrograms     LoyaltyProgram[] // inversa de LoyaltyProgram.freeService

  @@index([organizationId, active, sortOrder])
  @@map("service")
}

// ──────────────────── Equipo ────────────────────

model Barber {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName  String
  nickname     String?
  avatarUrl    String?
  specialties  String[] // array nativo Postgres
  rating       Float    @default(0) // métrica de presentación (no dinero)
  reviewsCount Int      @default(0)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  workingHours       WorkingHour[]
  appointments       Appointment[]
  scheduleExceptions ScheduleException[]
  reviews            Review[]
  barberInvitations  BarberInvitation[]

  commission  BarberCommission?
  settlements CommissionSettlement[]

  @@index([organizationId, active, sortOrder])
  @@index([branchId])
  @@index([userId])
  @@map("barber")
}

model WorkingHour {
  id       String @id @default(cuid())
  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = domingo … 6 = sábado
  startMin  Int // minutos desde medianoche (09:00 → 540)
  endMin    Int // (20:00 → 1200)

  @@index([barberId, dayOfWeek])
  @@map("working_hour")
}

model ScheduleException {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // null = toda la organización bloqueada ese día (festivo global)
  barberId String?
  barber   Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  date   String // YYYY-MM-DD en zona horaria del tenant
  reason String? // "Festivo nacional", "Vacaciones", etc.

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Un barbero (o la org) solo puede tener una excepción por día
  @@unique([organizationId, barberId, date])
  @@index([organizationId, date])
  @@map("schedule_exception")
}

// ──────────────────── CRM mínimo ────────────────────

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String // E.164 normalizado, ej. +573104567890
  email String?
  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  appointments Appointment[]

  // un cliente por teléfono dentro de la barbería
  @@unique([organizationId, phone])
  @@index([organizationId, name])
  @@map("customer")
}

// ──────────────────── Núcleo: Citas ────────────────────

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  barberId   String
  barber     Barber    @relation(fields: [barberId], references: [id], onDelete: Restrict)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Servicios de la cita (1 o más). El precio/duración por línea son snapshot;
  // Appointment.priceCop / durationMin son los TOTALES (suma de las líneas).
  appointmentServices AppointmentService[]

  // Snapshot del cliente (resiliente aunque se borre el Customer)
  customerName  String
  customerPhone String

  startAt     DateTime @db.Timestamptz(6) // UTC
  endAt       DateTime @db.Timestamptz(6) // UTC (= startAt + durationMin)
  durationMin Int // snapshot
  priceCop    Int // snapshot (pesos enteros COP)

  status AppointmentStatus @default(confirmed)
  source AppointmentSource @default(online)
  notes  String?

  // Creada fuera del horario laboral del barbero (informativo, no bloquea)
  isOffHours Boolean @default(false)

  // El descuento de lealtad se aplicó pero redeemReward falló tras crear la cita.
  // El owner verá un indicador para revisar manualmente la discrepancia.
  redemptionFailed Boolean @default(false)

  createdByUserId String? // quién la creó (alta manual en panel)

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  review Review?

  @@index([organizationId, startAt])
  @@index([organizationId, barberId, startAt])
  @@index([organizationId, status, startAt])
  @@index([organizationId, customerId, startAt])
  @@index([branchId, startAt])
  @@map("appointment")
}

// Línea de servicio de una cita (relación N:M Appointment↔Service).
// Snapshot de precio/duración por línea: el desglose nunca deriva aunque el
// owner edite el servicio después. La suma de las líneas = Appointment total.
model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  // Cascade (no Restrict): los servicios se borran en duro solo al desmantelar
  // toda la org (Organization→Service es Cascade); en el flujo normal se
  // desactivan (active=false), no se borran. Cascade evita que el borrado de la
  // org choque con esta FK al eliminar servicios y citas en paralelo.
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  priceCop    Int // snapshot (pesos enteros COP)
  durationMin Int // snapshot

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_service")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  barbers       Barber[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ──────────────────── Reseñas ────────────────────

model Review {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barberId       String
  barber         Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointmentId  String       @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, barberId, createdAt])
  @@map("review")
}

// ──────────────────── Invitaciones de barbero ────────────────────────────────

model BarberInvitation {
  id             String   @id @default(cuid())
  token          String   @unique
  barberId       String
  organizationId String
  used           Boolean  @default(false)
  expiresAt      DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  barber         Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("barber_invitation")
}

// ──────────────────── Códigos de acceso (registro controlado) ────────────────

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  isUsed    Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String

  @@index([code])
  @@index([isUsed, expiresAt])
  @@map("access_code")
}

// ──────────────────── Programa de Lealtad ────────────────────
// Configuración 1:1 con Organization (patrón AdminNote: organizationId @unique +
// upsert). El dueño define el umbral de visitas y el tipo de recompensa.

model LoyaltyProgram {
  id             String   @id @default(cuid())
  organizationId String   @unique
  isActive       Boolean  @default(true)

  requiredVisits Int        @default(5) // N citas completadas para activar la recompensa
  rewardType     RewardType
  discountPct    Int? // 1-100 si rewardType = DISCOUNT_PCT
  discountAmount Int? // monto fijo COP si rewardType = DISCOUNT_AMOUNT
  freeServiceId  String? // serviceId si rewardType = FREE_SERVICE

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  freeService  Service?     @relation(fields: [freeServiceId], references: [id], onDelete: SetNull)

  @@map("loyalty_program")
}

// Progreso de un cliente (por teléfono) dentro de un tenant.
model LoyaltyCard {
  id             String @id @default(cuid())
  organizationId String
  customerPhone  String // identificador del cliente (E.164)
  customerName   String // último nombre conocido, para mostrar

  completedVisits Int     @default(0) // visitas desde el último reset
  totalVisits     Int     @default(0) // histórico, nunca se resetea
  rewardsEarned   Int     @default(0) // cuántas veces alcanzó el umbral
  rewardPending   Boolean @default(false) // tiene una recompensa sin usar

  lastVisitAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, customerPhone])
  @@index([organizationId])
  @@map("loyalty_card")
}

// Log de canjes — habilita la métrica "recompensas este mes" (owner + admin) con
// agregación DB-side y deja traza financiera del descuento aplicado.
model LoyaltyRedemption {
  id             String     @id @default(cuid())
  organizationId String
  customerPhone  String
  rewardType     RewardType
  discountCop    Int
  appointmentId  String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("loyalty_redemption")
}

// ──────────────────── Comisiones por barbero ────────────────────
// Configuración 1:1 con Barber (barberId @unique). El owner define el % o el
// monto fijo por servicio. Sin registro → la comisión del barbero es 0.

model BarberCommission {
  id             String @id @default(cuid())
  barberId       String @unique
  organizationId String

  commissionType CommissionType
  percentage     Int? // 1-100 si commissionType = PERCENTAGE
  fixedAmount    Int? // COP fijo por servicio si commissionType = FIXED_PER_SERVICE

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("barber_commission")
}

// Histórico de liquidaciones (pagos al barbero). La comisión se calcula on-demand
// desde Appointment + BarberCommission; aquí solo se "congela" lo pagado en un período.
model CommissionSettlement {
  id             String @id @default(cuid())
  barberId       String
  organizationId String

  periodStart DateTime @db.Timestamptz(6)
  periodEnd   DateTime @db.Timestamptz(6)

  grossRevenueCop  Int // total facturado por el barbero en el período
  commissionCop    Int // lo que le corresponde al barbero
  appointmentCount Int // citas completadas en el período

  paid   Boolean   @default(false)
  paidAt DateTime? @db.Timestamptz(6)
  notes  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, barberId])
  @@index([organizationId, periodStart])
  @@map("commission_settlement")
}
